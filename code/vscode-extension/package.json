{
  "name": "ictl-language",
  "displayName": "Abhinu.Dev Basic ICTL Language Support",
  "description": "Language support for Abhinu.Dev Basic ICTL",
  "version": "1.1.0",
  "publisher": "IndianCoder3",
  "icon": "ictl_icon.ico",

  "engines": {
    "vscode": "^1.80.0"
  },

  "categories": [
    "Programming Languages"
  ],

  "repository": {
    "type": "git",
    "url": "https://github.com/IndianCoder3/abhinu-dev_basic-ictl"
  },

  "activationEvents": [
    "onLanguage:ictl"
  ],

  "main": "./extension.js",

  "contributes": {
    "languages": [
      {
        "id": "ictl",
        "aliases": ["ICTL"],
        "extensions": [".ictl"],
        "configuration": "./language-configuration.json"
      }
    ],

    "grammars": [
      {
        "language": "ictl",
        "scopeName": "source.ictl",
        "path": "./syntaxes/ictl.tmLanguage.json"
      }
    ]
  }
}