# ==========================================================
# ==============EXAMPLE SCRIPT: MATH BOT====================
# ==========================================================

# Define the main program via Program.Main
Program.Main {

    # Set the style to green
    Terminal.Style("green")

    # Init new variables
    Variables.New(Name)
    Variables.New(MathQuestion)
    Variables.New(UserResponse)

    # Take the user's name
    Variables.Name = Terminal.Ask("What is your name: ")

    # Greet the user
    Terminal.Style("yellow")
    Terminal.Echo("Hi, " + Variables.Name + "!")
    Terminal.Style("cyan")

    # A Program.ForeverLoop for math
    Program.ForeverLoop {

        # Ask the user for a math question
        Variables.MathQuestion = Terminal.Ask("Give me a math question and I will solve it: ")

        # Evaluate and show the answer
        Terminal.Echo("The answer is: " + Math.Eval(Variables.MathQuestion))

        # Ask if the user wants to continue
        Variables.UserResponse = Terminal.Ask("Do you want to ask another question? (yes/no): ")

        # If the user says "no", exit the loop
        Program.If(Data.Compare(Variables.UserResponse, "no")) {
            Terminal.Echo("Goodbye, " + Variables.Name + "!")
            Terminal.Style("reset")
            Program.BreakLoop
        }
    }
}