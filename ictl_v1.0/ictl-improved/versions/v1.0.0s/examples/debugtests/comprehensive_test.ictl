Program.Main {
    Terminal.Echo("========== COMPREHENSIVE TEST ==========")
    
    Terminal.Echo("Test 1: Variables and basic math")
    Variables.New(X)
    Variables.X = Math.Eval(10 + 5)
    Terminal.Echo("X = " + Variables.X)
    
    Terminal.Echo("Test 2: String concatenation with operators")
    Variables.New(Formula)
    Variables.Formula = "2 + 3 + 5"
    Terminal.Echo("Formula: " + Variables.Formula)
    
    Terminal.Echo("Test 3: Float arithmetic")
    Variables.New(Result)
    Variables.Result = Math.Eval(3.5 + 2.5)
    Terminal.Echo("3.5 + 2.5 = " + Variables.Result)
    
    Terminal.Echo("Test 4: Negative numbers")
    Variables.New(NegTest)
    Variables.NegTest = Math.Eval(-10 + 5)
    Terminal.Echo("-10 + 5 = " + Variables.NegTest)
    
    Terminal.Echo("Test 5: Data.Compare")
    Program.If(Data.Compare(Variables.X, 15)) {
        Terminal.Echo("Data.Compare PASS: X equals 15")
    }
    
    Terminal.Echo("Test 6: Math.Compare with various operators")
    Program.If(Math.Compare(20, ">", 15)) {
        Terminal.Echo("Math.Compare PASS: 20 > 15")
    }
    
    Program.If(Math.Compare(3, "<=", 3)) {
        Terminal.Echo("Math.Compare PASS: 3 <= 3")
    }
    
    Program.If(Math.Compare(5, "!=", 3)) {
        Terminal.Echo("Math.Compare PASS: 5 != 3")
    }
    
    Terminal.Echo("========== ALL TESTS COMPLETED ==========")
}
