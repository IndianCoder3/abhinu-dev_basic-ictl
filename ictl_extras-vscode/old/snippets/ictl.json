    "description": "Make text bold"
  },
  "Terminal Italic": {
    "prefix": "italic",
    "body": "Terminal.Italic",
    "description": "Make text italic"
  },
  "Terminal Underline": {
    "prefix": "underline",
    "body": "Terminal.Underline",
    "description": "Underline text"
  },
  "Terminal Reset": {
    "prefix": "reset",
    "body": "Terminal.Reset",
    "description": "Reset terminal formatting"
  },
  "Terminal Write": {
