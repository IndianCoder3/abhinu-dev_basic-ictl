  },
  "Complete Terminal Example": {
    "prefix": "termex",
    "body": [
      "Program.Main {",
      "\tTerminal.Color(\"blue\")",
      "\tTerminal.Bold",
      "\tTerminal.Echo(\"Welcome!\")",
      "\tTerminal.Reset",
      "\t",
      "\tVariables.New(UserInput)",
      "\tVariables.UserInput = Terminal.Ask(\"Enter something: \")",
      "\tTerminal.Echo(\"You entered: \" + Variables.UserInput)",
      "\t",
      "\tTerminal.Pause",
      "}"
    ],
    "description": "Complete terminal interaction example with colors and formatting"
  }
}