{
  "name": "ICTL",
  "scopeName": "source.ictl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#modules"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#brackets"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.ictl",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.ictl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ictl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ictl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ictl",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ictl",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ictl",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.ictl",
          "match": "\\b(True|False)\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "keyword.other.ictl",
          "match": "\\b(Program|Terminal|Math|Variables|Data)\\b"
        },
        {
          "name": "keyword.other.ictl",
          "match": "\\b(Main|If|Loop|ForeverLoop|BreakLoop|Continue)\\b"
        },
        {
          "name": "support.function.terminal.ictl",
          "match": "\\b(Terminal)\\.(Echo|Ask|Style|Clear|Pause|Color|Background|Bold|Italic|Underline|Reset|Write)\\b"
        },
        {
          "name": "support.function.variables.ictl",
          "match": "\\b(Variables)\\.(New|Delete|Clear|Exists)\\b"
        },
        {
          "name": "support.function.math.ictl",
          "match": "\\b(Math)\\.(Eval|Compare)\\b"
        },
        {
          "name": "support.function.data.ictl",
          "match": "\\b(Data)\\.(Compare|Parse|Format)\\b"
        },
        {
          "name": "entity.name.function.ictl",
          "match": "\\b(Terminal|Variables|Math|Data|Program)\\."
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ictl",
          "match": "\\+|\\-|\\*|/|==|!=|>=|<=|>|<|="
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.section.braces.begin.ictl",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.ictl",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.ictl",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.ictl",
          "match": "\\)"
        }
      ]
    }
  }
}