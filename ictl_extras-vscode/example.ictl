Program.Main {
    # This is a comment
    Variables.New(Name)
    Variables.Name = Terminal.Ask("What is your name: ")

    Terminal.Echo("Hi, " + Variables.Name + "!")

    Variables.New(Result)
    Variables.Result = Math.Eval(2 + 2)

    Terminal.Echo("The 2+2 test says: " + Variables.Result)

    # Conditional example
    Program.If(Math.Compare(Variables.Result, "==", 4)) {
        Terminal.Style("green")
        Terminal.Echo("Math works correctly!")
        Terminal.Style("reset")
    }

    # Loop example
    Program.Loop(3) {
        Terminal.Echo("Looping...")
    }

    # Forever loop with break
    Variables.New(Counter)
    Variables.Counter = 0
    Program.ForeverLoop {
        Variables.Counter = Math.Eval(Variables.Counter + 1)
        Terminal.Echo("Count: " + Variables.Counter)

        Program.If(Math.Compare(Variables.Counter, ">=", 5)) {
            Program.BreakLoop
        }
    }
}