Program.Main {
    Variables.New(Counter)
    Variables.Counter = 0

    Terminal.Echo("Starting loop...")

    Program.Loop(5) {
        Variables.Counter = Math.Eval(Variables.Counter + 1)
        Terminal.Echo("Counter: " + Variables.Counter)
        
        Program.If(Data.Compare(Variables.Counter, 3)) {
            Terminal.Echo("  -> Counter is 3!")
        }
    }
    
    Terminal.Echo("Done!")
}
