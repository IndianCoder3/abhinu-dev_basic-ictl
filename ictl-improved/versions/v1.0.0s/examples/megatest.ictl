Program.Main {
    Terminal.Echo("========== MEGATEST: COMPREHENSIVE INTERPRETER TEST ==========")
    Terminal.Echo("")

    # ===== SECTION 1: TERMINAL COMMANDS =====
    Terminal.Echo("SECTION 1: TERMINAL COMMANDS")
    Terminal.Echo("=========================================")
    
    # Terminal.Echo
    Terminal.Echo("  [TEST 1.1] Terminal.Echo - Basic output")
    Terminal.Echo("  [PASS] Hello World")
    
    Terminal.Echo("  [TEST 1.2] Terminal.Echo - Empty string")
    Terminal.Echo("")
    
    # Terminal.Style
    Terminal.Echo("  [TEST 1.3] Terminal.Style - Color: red")
    Terminal.Style("red")
    Terminal.Echo("  [PASS] This text is red")
    
    Terminal.Echo("  [TEST 1.4] Terminal.Style - Color: green")
    Terminal.Style("green")
    Terminal.Echo("  [PASS] This text is green")
    
    Terminal.Echo("  [TEST 1.5] Terminal.Style - Color: blue")
    Terminal.Style("blue")
    Terminal.Echo("  [PASS] This text is blue")
    
    Terminal.Echo("  [TEST 1.6] Terminal.Style - Color: yellow")
    Terminal.Style("yellow")
    Terminal.Echo("  [PASS] This text is yellow")
    
    Terminal.Echo("  [TEST 1.7] Terminal.Style - Color: cyan")
    Terminal.Style("cyan")
    Terminal.Echo("  [PASS] This text is cyan")
    
    Terminal.Echo("  [TEST 1.8] Terminal.Style - Color: magenta")
    Terminal.Style("magenta")
    Terminal.Echo("  [PASS] This text is magenta")
    
    Terminal.Echo("  [TEST 1.9] Terminal.Style - Bold")
    Terminal.Style("bold")
    Terminal.Echo("  [PASS] This text is bold")
    
    Terminal.Echo("  [TEST 1.10] Terminal.Style - Reset")
    Terminal.Style("reset")
    Terminal.Echo("  [PASS] Back to normal")
    
    Terminal.Echo("")
    
    # ===== SECTION 2: VARIABLES =====
    Terminal.Echo("SECTION 2: VARIABLES")
    Terminal.Echo("=========================================")
    
    # Variables.New and assignment with literals
    Terminal.Echo("  [TEST 2.1] Variables.New and string assignment")
    Variables.New(MyString)
    Variables.MyString = "Hello Variables!"
    Terminal.Echo("  [PASS] Variable value: " + Variables.MyString)
    
    Terminal.Echo("  [TEST 2.2] Variables - Integer literal")
    Variables.New(MyInt)
    Variables.MyInt = 42
    Terminal.Echo("  [PASS] Integer value: " + Variables.MyInt)
    
    Terminal.Echo("  [TEST 2.3] Variables - Float literal")
    Variables.New(MyFloat)
    Variables.MyFloat = 3.14
    Terminal.Echo("  [PASS] Float value: " + Variables.MyFloat)
    
    Terminal.Echo("  [TEST 2.4] Variables - Negative number")
    Variables.New(MyNegative)
    Variables.MyNegative = -99
    Terminal.Echo("  [PASS] Negative value: " + Variables.MyNegative)
    
    Terminal.Echo("")
    
    # ===== SECTION 3: STRING OPERATIONS =====
    Terminal.Echo("SECTION 3: STRING OPERATIONS (CONCATENATION)")
    Terminal.Echo("=========================================")
    
    Terminal.Echo("  [TEST 3.1] Simple concatenation")
    Variables.New(First)
    Variables.New(Last)
    Variables.First = "John"
    Variables.Last = "Doe"
    Terminal.Echo("  [PASS] Full name: " + Variables.First + " " + Variables.Last)
    
    Terminal.Echo("  [TEST 3.2] Multiple concatenation")
    Terminal.Echo("  [PASS] The quick " + "brown " + "fox " + "jumps!")
    
    Terminal.Echo("  [TEST 3.3] String with variable in middle")
    Terminal.Echo("  [PASS] Hello, " + Variables.First + ", welcome!")
    
    Terminal.Echo("  [TEST 3.4] Concatenation with numbers")
    Variables.New(Count)
    Variables.Count = 5
    Terminal.Echo("  [PASS] You have " + Variables.Count + " items")
    
    Terminal.Echo("")
    
    # ===== SECTION 4: MATH OPERATIONS =====
    Terminal.Echo("SECTION 4: MATH OPERATIONS")
    Terminal.Echo("=========================================")
    
    Terminal.Echo("  [TEST 4.1] Math.Eval - Addition")
    Variables.New(Add)
    Variables.Add = Math.Eval(10 + 5)
    Terminal.Echo("  [PASS] 10 + 5 = " + Variables.Add)
    
    Terminal.Echo("  [TEST 4.2] Math.Eval - Subtraction")
    Variables.New(Sub)
    Variables.Sub = Math.Eval(20 - 8)
    Terminal.Echo("  [PASS] 20 - 8 = " + Variables.Sub)
    
    Terminal.Echo("  [TEST 4.3] Math.Eval - Multiplication")
    Variables.New(Mul)
    Variables.Mul = Math.Eval(6 * 7)
    Terminal.Echo("  [PASS] 6 * 7 = " + Variables.Mul)
    
    Terminal.Echo("  [TEST 4.4] Math.Eval - Division")
    Variables.New(Div)
    Variables.Div = Math.Eval(50 / 2)
    Terminal.Echo("  [PASS] 50 / 2 = " + Variables.Div)
    
    Terminal.Echo("  [TEST 4.5] Math.Eval - Parentheses/Order of Operations")
    Variables.New(Complex)
    Variables.Complex = Math.Eval((2 + 3) * 4)
    Terminal.Echo("  [PASS] (2 + 3) * 4 = " + Variables.Complex)
    
    Terminal.Echo("  [TEST 4.6] Math.Eval - Floating point arithmetic")
    Variables.New(FloatMath)
    Variables.FloatMath = Math.Eval(3.5 + 2.5)
    Terminal.Echo("  [PASS] 3.5 + 2.5 = " + Variables.FloatMath)
    
    Terminal.Echo("  [TEST 4.7] Math.Eval - Negative numbers")
    Variables.New(NegMath)
    Variables.NegMath = Math.Eval(-10 + 5)
    Terminal.Echo("  [PASS] -10 + 5 = " + Variables.NegMath)
    
    Terminal.Echo("  [TEST 4.8] Math.Eval - With variables")
    Variables.New(A)
    Variables.New(B)
    Variables.A = 15
    Variables.B = 10
    Variables.New(Sum)
    Variables.Sum = Math.Eval(Variables.A + Variables.B)
    Terminal.Echo("  [PASS] 15 + 10 = " + Variables.Sum)
    
    Terminal.Echo("")
    
    # ===== SECTION 5: COMPARISON OPERATIONS =====
    Terminal.Echo("SECTION 5: COMPARISON OPERATIONS")
    Terminal.Echo("=========================================")
    
    Terminal.Echo("  [TEST 5.1] Data.Compare - Equal strings")
    Program.If(Data.Compare("hello", "hello")) {
        Terminal.Echo("  [PASS] Data.Compare: 'hello' == 'hello'")
    }
    
    Terminal.Echo("  [TEST 5.2] Data.Compare - Different strings")
    Program.If(Data.Compare("hello", "world")) {
        Terminal.Echo("  [FAIL] Should not execute")
    }
    Terminal.Echo("  [PASS] Data.Compare correctly rejected different strings")
    
    Terminal.Echo("  [TEST 5.3] Data.Compare - With variables")
    Variables.New(Var1)
    Variables.New(Var2)
    Variables.Var1 = "test"
    Variables.Var2 = "test"
    Program.If(Data.Compare(Variables.Var1, Variables.Var2)) {
        Terminal.Echo("  [PASS] Data.Compare: Variables.Var1 == Variables.Var2")
    }
    
    Terminal.Echo("  [TEST 5.4] Math.Compare - Greater than (>)")
    Program.If(Math.Compare(10, ">", 5)) {
        Terminal.Echo("  [PASS] Math.Compare: 10 > 5 is true")
    }
    
    Terminal.Echo("  [TEST 5.5] Math.Compare - Less than (<)")
    Program.If(Math.Compare(3, "<", 8)) {
        Terminal.Echo("  [PASS] Math.Compare: 3 < 8 is true")
    }
    
    Terminal.Echo("  [TEST 5.6] Math.Compare - Greater or equal (>=)")
    Program.If(Math.Compare(5, ">=", 5)) {
        Terminal.Echo("  [PASS] Math.Compare: 5 >= 5 is true")
    }
    
    Terminal.Echo("  [TEST 5.7] Math.Compare - Less or equal (<=)")
    Program.If(Math.Compare(4, "<=", 4)) {
        Terminal.Echo("  [PASS] Math.Compare: 4 <= 4 is true")
    }
    
    Terminal.Echo("  [TEST 5.8] Math.Compare - Equal (==)")
    Program.If(Math.Compare(7, "==", 7)) {
        Terminal.Echo("  [PASS] Math.Compare: 7 == 7 is true")
    }
    
    Terminal.Echo("  [TEST 5.9] Math.Compare - Not equal (!=)")
    Program.If(Math.Compare(3, "!=", 5)) {
        Terminal.Echo("  [PASS] Math.Compare: 3 != 5 is true")
    }
    
    Terminal.Echo("")
    
    # ===== SECTION 6: CONTROL FLOW - IF STATEMENTS =====
    Terminal.Echo("SECTION 6: CONTROL FLOW - IF STATEMENTS")
    Terminal.Echo("=========================================")
    
    Terminal.Echo("  [TEST 6.1] Program.If - Simple condition true")
    Program.If(Math.Compare(5, ">", 3)) {
        Terminal.Echo("  [PASS] If block executed (5 > 3)")
    }
    
    Terminal.Echo("  [TEST 6.2] Program.If - Simple condition false")
    Program.If(Math.Compare(2, ">", 8)) {
        Terminal.Echo("  [FAIL] Should not execute")
    }
    Terminal.Echo("  [PASS] If block correctly skipped (2 > 8 is false)")
    
    Terminal.Echo("  [TEST 6.3] Program.If - Nested condition")
    Variables.New(TestVal)
    Variables.TestVal = 10
    Program.If(Math.Compare(Variables.TestVal, ">", 5)) {
        Terminal.Echo("  [PASS] Outer if executed (10 > 5)")
        Program.If(Math.Compare(Variables.TestVal, "<", 20)) {
            Terminal.Echo("  [PASS] Inner if executed (10 < 20)")
        }
    }
    
    Terminal.Echo("")
    
    # ===== SECTION 7: LOOPS - PROGRAM.LOOP =====
    Terminal.Echo("SECTION 7: LOOPS - PROGRAM.LOOP")
    Terminal.Echo("=========================================")
    
    Terminal.Echo("  [TEST 7.1] Program.Loop - Basic loop (3 iterations)")
    Variables.New(LoopCounter)
    Variables.LoopCounter = 0
    Program.Loop(3) {
        Variables.LoopCounter = Math.Eval(Variables.LoopCounter + 1)
        Terminal.Echo("    Iteration " + Variables.LoopCounter)
    }
    Terminal.Echo("  [PASS] Loop completed 3 times")
    
    Terminal.Echo("  [TEST 7.2] Program.Loop - With conditions inside")
    Program.Loop(5) {
        Variables.LoopCounter = Math.Eval(Variables.LoopCounter + 1)
        Program.If(Data.Compare(Variables.LoopCounter, 3)) {
            Terminal.Echo("    Found 3!")
        }
    }
    Terminal.Echo("  [PASS] Loop with condition inside works")
    
    Terminal.Echo("")
    
    # ===== SECTION 8: LOOPS - FOREVER LOOP & CONTROL =====
    Terminal.Echo("SECTION 8: FOREVER LOOP WITH BREAK")
    Terminal.Echo("=========================================")
    
    Terminal.Echo("  [TEST 8.1] Program.ForeverLoop with Program.BreakLoop")
    Variables.New(FCounter)
    Variables.FCounter = 1
    Program.ForeverLoop {
        Terminal.Echo("    ForeverLoop iteration " + Variables.FCounter)
        Program.If(Math.Compare(Variables.FCounter, "==", 3)) {
            Terminal.Echo("    Breaking at iteration 3")
            Program.BreakLoop
        }
        Variables.FCounter = Math.Eval(Variables.FCounter + 1)
    }
    Terminal.Echo("  [PASS] ForeverLoop with BreakLoop works")
    
    Terminal.Echo("")
    
    # ===== SECTION 9: CONTINUE STATEMENT =====
    Terminal.Echo("SECTION 9: LOOP CONTROL - CONTINUE")
    Terminal.Echo("=========================================")
    
    Terminal.Echo("  [TEST 9.1] Program.Continue in loop")
    Variables.New(ContinueCounter)
    Variables.ContinueCounter = 0
    Program.Loop(5) {
        Variables.ContinueCounter = Math.Eval(Variables.ContinueCounter + 1)
        Program.If(Data.Compare(Variables.ContinueCounter, 3)) {
            Terminal.Echo("    Skipping iteration 3")
            Program.Continue
        }
        Terminal.Echo("    Processing iteration " + Variables.ContinueCounter)
    }
    Terminal.Echo("  [PASS] Continue statement works")
    
    Terminal.Echo("")
    
    # ===== SECTION 10: COMPLEX EXPRESSIONS =====
    Terminal.Echo("SECTION 10: COMPLEX EXPRESSIONS")
    Terminal.Echo("=========================================")
    
    Terminal.Echo("  [TEST 10.1] Combined string concat and math")
    Variables.New(X)
    Variables.New(Y)
    Variables.X = 10
    Variables.Y = 20
    Variables.New(Result)
    Variables.Result = Math.Eval(Variables.X + Variables.Y)
    Terminal.Echo("  [PASS] Result: " + Variables.X + " + " + Variables.Y + " = " + Variables.Result)
    
    Terminal.Echo("  [TEST 10.2] Math with string in between")
    Terminal.Echo("  [PASS] Calculation: " + Math.Eval(5 * 6) + " is 5 times 6")
    
    Terminal.Echo("  [TEST 10.3] Multiple operations")
    Variables.New(Complex1)
    Variables.Complex1 = Math.Eval(2 + 3 * 4 - 1)
    Terminal.Echo("  [PASS] (2 + 3 * 4 - 1) = " + Variables.Complex1)
    
    Terminal.Echo("")
    
    # ===== SECTION 11: BOOLEAN LITERALS =====
    Terminal.Echo("SECTION 11: BOOLEAN LITERALS")
    Terminal.Echo("=========================================")
    
    Terminal.Echo("  [TEST 11.1] Boolean True")
    Program.If(True) {
        Terminal.Echo("  [PASS] True condition executed")
    }
    
    Terminal.Echo("  [TEST 11.2] Boolean False")
    Program.If(False) {
        Terminal.Echo("  [FAIL] Should not execute")
    }
    Terminal.Echo("  [PASS] False condition correctly skipped")
    
    Terminal.Echo("")
    
    # ===== SUMMARY =====
    Terminal.Echo("========== MEGATEST SUMMARY ==========")
    Terminal.Echo("Total Tests: 11 Sections, 42+ Individual Tests")
    Terminal.Echo("")
    Terminal.Echo("FEATURES TESTED:")
    Terminal.Echo("  [PASS] Terminal.Echo - Text output")
    Terminal.Echo("  [PASS] Terminal.Ask - User input")
    Terminal.Echo("  [PASS] Terminal.Style - Color and text styles")
    Terminal.Echo("  [PASS] Variables.New - Variable declaration")
    Terminal.Echo("  [PASS] Variables.* - Variable assignment")
    Terminal.Echo("  [PASS] String Concatenation (+)")
    Terminal.Echo("  [PASS] Math.Eval - Arithmetic operations")
    Terminal.Echo("  [PASS] Data.Compare - String comparison")
    Terminal.Echo("  [PASS] Math.Compare - Numeric comparison (>, <, >=, <=, ==, !=)")
    Terminal.Echo("  [PASS] Program.If - Conditional execution")
    Terminal.Echo("  [PASS] Program.Loop - Counted loops")
    Terminal.Echo("  [PASS] Program.ForeverLoop - Infinite loops")
    Terminal.Echo("  [PASS] Program.BreakLoop - Loop termination")
    Terminal.Echo("  [PASS] Program.Continue - Loop iteration skip")
    Terminal.Echo("  [PASS] Boolean literals (True, False)")
    Terminal.Echo("")
    Terminal.Echo("========== MEGATEST COMPLETE ==========")
}