Program.Main {
    Variables.New(Counter)
    Variables.Counter = 3

    Program.If(Data.Compare(Variables.Counter, 3)) {
        Terminal.Echo("Data.Compare test PASSED: Counter equals 3")
    }

    Program.If(Math.Compare(5, ">", 3)) {
        Terminal.Echo("Math.Compare test PASSED: 5 > 3 is true")
    }

    Program.If(Math.Compare(2, "<=", 2)) {
        Terminal.Echo("Math.Compare test PASSED: 2 <= 2 is true")
    }

    Terminal.Echo("All tests completed!")
}
