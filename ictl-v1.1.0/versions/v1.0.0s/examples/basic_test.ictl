Program.Main {
    Variables.New(Name)
    Variables.Name = Terminal.Ask("What is your name: ")

    Terminal.Echo("Hi, " + Variables.Name + "!")

    Variables.New(Result)
    Variables.Result = Math.Eval(2 + 2)

    Terminal.Echo("The 2+2 test says: " + Variables.Result)
    Terminal.Echo(Variables.Name)
}
