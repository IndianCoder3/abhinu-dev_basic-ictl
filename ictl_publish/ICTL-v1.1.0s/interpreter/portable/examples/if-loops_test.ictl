# ==========================================================
# ==============EXAMPLE SCRIPT: IF AND LOOPS================
# ==========================================================

# This is an example script for the ictl language demonstrating terminal styling and loop control.
# It initializes a counter, enters an infinite loop, increments the counter,
# and breaks the loop when the counter reaches 5, applying different terminal styles throughout.

# Program.Main to execute the main logic
Program.Main {

    # Set terminal style to blue and indicate start
    Terminal.Style("blue")
    Terminal.Echo("Starting the loop example script.")

    # Initialize counter variable
    Variables.New(Counter)
    Variables.Counter = 0

    # Change terminal style to yellow before entering the loop, and change the style again to cyan
    Terminal.Style("yellow")
    Terminal.Echo("Looping Forever")
    Terminal.Style("cyan")

    # Start an ForeverLoop
    Program.ForeverLoop {
        # Increment counter
        Variables.Counter = Math.Eval(Variables.Counter + 1)

        Terminal.Echo("Counter: " + Variables.Counter)
        Program.If(Data.Compare(Variables.Counter, 5)) {
            Terminal.Style("magenta")
            Terminal.Echo("Breaking the loop as counter reached 5")
            Terminal.Style("reset")
            Program.BreakLoop
        }
    }
}