Program.Main {
    Variables.New("randomNumber")
    Variables.New("userGuess")
    Variables.New("guessCount")
    Variables.New("startTime")
    Variables.New("endTime")

    Variables.randomNumber = Math.Random(1, 100)
    Variables.userGuess = 0
    Variables.guessCount = 0
    Variables.startTime = Time.Current("hh:mm:ss tt")
    

    Terminal.Clear
    Terminal.Style("green")
    Terminal.Echo("Welcome to the Random Number Guessing Game!")
    Terminal.Echo("I have selected a random number between 1 and 100. Can you guess it? ")
    Terminal.Style("reset")
    Terminal.Echo("")
    Program.ForeverLoop {
        Variables.userGuess = Terminal.Ask("Please enter your guess: ")
        Variables.guessCount = Math.Eval((Variables.guessCount) + 1)
        Program.If(Math.Compare(Variables.userGuess, "<", Variables.randomNumber)) {
            Terminal.Echo("Too low! Try again.")
        }
        Program.Else {
            Program.If(Math.Compare(Variables.userGuess, ">", Variables.randomNumber)) {
                Terminal.Echo("Too high! Try again.")
            } 
            Program.Else {
                Terminal.Style("cyan")
                Terminal.Echo("")
                Terminal.Echo("Congratulations! You've guessed the number!")
                Terminal.Echo("It took you " + Variables.guessCount + " guesses.")
                Variables.endTime = Time.Current("hh:mm:ss tt")
                Terminal.Echo("You started at: " + Variables.startTime)
                Terminal.Echo("You ended at: " + Variables.endTime)
                Terminal.Style("reset")
                Program.BreakLoop
            }
        }
    }
}