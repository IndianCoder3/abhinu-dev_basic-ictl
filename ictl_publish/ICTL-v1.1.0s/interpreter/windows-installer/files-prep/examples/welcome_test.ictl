Program.Main {
    # Ask for user name
    Variables.New(Name)
    Variables.Name = Terminal.Ask("Hello! What's your name? ")

    Terminal.Echo("Hi, " + Variables.Name + "! Welcome to Abhinu.Dev Basic ICTL Language!")
    Terminal.Echo("Let's learn how to use this small language step by step. Contributions are welcome!")
    Terminal.Echo("")

    # Step 1: Variables
    Terminal.Echo("Step 1: Variables")
    Terminal.Echo("You can declare a new variable like this:")
    Terminal.Echo("    Variables.New(MyVariable)")
    Terminal.Echo("And assign a value:")
    Terminal.Echo("    Variables.MyVariable = "Hello"")
    Terminal.Echo("Try it now!")

    # Ask user to type a value for a new variable
    Variables.New(FavoriteColor)
    Variables.FavoriteColor = Terminal.Ask("Type your favorite color: ")
    Terminal.Echo("Nice! You stored it in Variables.FavoriteColor")

    Terminal.Echo("Oh, so you like " + Variables.FavoriteColor + "!")


    # Step 2: Terminal I/O
    Terminal.Echo("Step 2: Terminal Input and Output")
    Terminal.Echo("You can print text using Terminal.Echo(...)")
    Terminal.Echo("You can ask the user for input using Terminal.Ask(...)")
    Terminal.Echo("Let's see it in action!")

    # Show example
    Variables.New(FavoriteFood)
    Variables.FavoriteFood = Terminal.Ask("What's your favorite food? ")
    Terminal.Echo("Wow! So your favorite food is " + Variables.FavoriteFood + "!")

    Terminal.Echo("")
    # Step 3: Math
    Terminal.Echo("Step 3: Math")
    Terminal.Echo("You can calculate expressions using Math.Eval(...)")
    Variables.New(MathResult)
    Variables.MathExpression = Terminal.Ask("Give me a math expression, like 2+2: ")
    Variables.MathResult = Math.Eval(Variables.MathExpression)
    Terminal.Echo("The result is: " + Variables.MathResult)

    Terminal.Echo("")
    # Step 4: Data comparison
    Terminal.Echo("Step 4: Data comparison")
    Variables.New(DataTest)
    Variables.Data1 = Terminal.Ask("Type something: ")
    Variables.Data2 = Terminal.Ask("Type the same thing again: ")
    Variables.DataTest = Data.Compare(Variables.Data1, Variables.Data2)
    Terminal.Echo("Are they the same? " + Variables.DataTest)

    Terminal.Echo("")
    Terminal.Echo("That's a quick intro to ICTL! 🎉")
    Terminal.Echo("Now you can declare variables, take input, print output, do math, and compare data!")
    Terminal.Echo("Try creating your own programs in a file and run them with ictl.exe!")
    Terminal.Echo("Happy coding, " + Variables.Name + "!")
}
